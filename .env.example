# FlowForge Environment Configuration Template
# Copy this file to .env and fill in values for local development.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowforge

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRE_MINUTES=60

# CORS (comma-separated or JSON list of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# Task Retry & Exponential Backoff
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_DELAY_SECONDS=300
